{
	"name": "portfolio",
	"version": "0.0.0",
	"description": "Cartago's portfolio — Angular 22 SSR application. Requires the active Node.js LTS (26.x). See .nvmrc.",
	"engines": {
		"node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26.0.0 <27"
	},
	"volta": {
		"node": "26",
		"bun": "1.4.3"
	},
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"test:e2e": "playwright test",
		"lint:src": "eslint --config config/eslint/eslint.config.ts src --ext .ts --cache --cache-location .cache/eslint/src.eslintcache",
		"lint:tests": "eslint --config config/eslint/eslint.config.ts \"src/**/*.spec.ts\" --cache --cache-location .cache/eslint/tests.eslintcache",
		"lint:e2e": "eslint --config config/eslint/eslint.config.ts \"e2e/**/*.ts\" playwright.config.ts --cache --cache-location .cache/eslint/e2e.eslintcache",
		"lint:tools": "eslint --config config/eslint/eslint.config.ts \"config/**/*.ts\" \"tools/check-*.script.ts\" --cache --cache-location .cache/eslint/tools.eslintcache",
		"lint": "bun run lint:src && bun run lint:tests && bun run lint:e2e && bun run lint:tools",
		"lint:ci": "bun run lint:src -- --max-warnings=0 && bun run lint:tests -- --max-warnings=0 && bun run lint:e2e -- --max-warnings=0 && bun run lint:tools -- --max-warnings=0",
		"lint:fix": "bun run lint:src -- --fix && bun run lint:tests -- --fix && bun run lint:e2e -- --fix && bun run lint:tools -- --fix",
		"format": "prettier --write \"{src,config,tools}/**/*.{ts,html,scss}\" \"*.json\"",
		"format:check": "prettier --check \"{src,config,tools}/**/*.{ts,html,scss}\" \"*.json\"",
		"format:styles": "prettier --write \"src/**/*.scss\"",
		"format:styles:check": "prettier --check \"src/**/*.scss\"",
		"typecheck": "bun run typecheck:src && bun run typecheck:tests && bun run typecheck:e2e",
		"typecheck:src": "tsc --noEmit -p tsconfig.app.json",
		"typecheck:tests": "tsc --noEmit -p tsconfig.spec.json",
		"typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
		"check": "(bun run lint) & (bun run typecheck) & wait",
		"check:naming": "bun tools/check-file-naming.script.ts",
		"ci:prepare": "bun run check:naming && bun run mcp:typecheck && bun run mcp:test",
		"ci:test": "bun run lint:ci && bun run typecheck && bun run test -- --watch=false && bun run test:e2e",
		"ci:build": "bun run build",
		"check:strict": "(bun run lint:ci) & (bun run typecheck) & bun run check:naming & wait",
		"validate": "(bun run check) & (bun run test) & wait",
		"validate:strict": "(bun run check:strict) & (bun run test) & wait",
		"mcp:check": "bun tools/check-delendai.script.ts",
		"mcp:test": "bun run --cwd plugins/portfolio-content test",
		"mcp:typecheck": "bun run --cwd plugins/portfolio-content typecheck",
		"mcp:all": "bun run mcp:typecheck && bun run mcp:test && bun run mcp:check",
		"serve:ssr:portfolio": "node dist/portfolio/server/server.mjs"
	},
	"private": true,
	"packageManager": "bun@1.4.3",
	"dependencies": {
		"@angular/common": "^22.3.0",
		"@angular/compiler": "^22.3.0",
		"@angular/core": "^22.3.0",
		"@angular/forms": "^22.3.0",
		"@angular/platform-browser": "^22.3.0",
		"@angular/platform-server": "^22.3.0",
		"@angular/router": "^22.3.0",
		"@angular/ssr": "^22.3.0",
		"@delendai/core": "file:vendor/delendai-core-0.3.0.tgz",
		"express": "^5.3.0",
		"rxjs": "~7.8.0",
		"simple-icons": "^16.38.0",
		"tslib": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@angular/build": "^22.3.0",
		"@angular/cli": "^22.3.0",
		"@angular/compiler-cli": "^22.3.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@types/express": "^5.0.1",
		"@types/node": "^26.0.0",
		"angular-eslint": "^22.8.0",
		"entities": "8.0.0",
		"eslint": "^10.15.0",
		"eslint-plugin-check-file": "^3.3.2",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"jsdom": "^28.0.0",
		"prettier": "^3.10.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^4.1.12"
	},
	"overrides": {
		"@delendai/contracts": "file:vendor/delendai-contracts-0.3.0.tgz",
		"@delendai/sqlite": "file:vendor/delendai-sqlite-0.3.0.tgz",
		"@delendai/state": "file:vendor/delendai-state-0.3.0.tgz"
	}
}
