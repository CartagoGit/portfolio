{
	"name": "portfolio",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint:src": "eslint --config config/eslint/eslint.config.ts src --ext .ts --cache --cache-location .cache/eslint/src.eslintcache",
		"lint:tests": "eslint --config config/eslint/eslint.config.ts \"src/**/*.spec.ts\" --cache --cache-location .cache/eslint/tests.eslintcache",
		"lint:tools": "eslint --config config/eslint/eslint.config.ts \"config/**/*.ts\" \"tools/**/*.ts\" --cache --cache-location .cache/eslint/tools.eslintcache",
		"lint": "bun run lint:src && bun run lint:tests && bun run lint:tools",
		"lint:ci": "bun run lint:src -- --max-warnings=0 && bun run lint:tests -- --max-warnings=0 && bun run lint:tools -- --max-warnings=0",
		"lint:fix": "bun run lint:src -- --fix && bun run lint:tests -- --fix && bun run lint:tools -- --fix",
		"format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,mjs}\"",
		"format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,mjs}\"",
		"format:styles": "prettier --write \"src/**/*.scss\"",
		"format:styles:check": "prettier --check \"src/**/*.scss\"",
		"typecheck": "bun run typecheck:src && bun run typecheck:tests",
		"typecheck:src": "tsc --noEmit -p tsconfig.app.json",
		"typecheck:tests": "tsc --noEmit -p tsconfig.spec.json",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
		"check": "(bun run lint) & (bun run typecheck) & wait",
		"check:strict": "(bun run lint:ci) & (bun run typecheck) & wait",
		"validate": "(bun run check) & (bun run test) & wait",
		"validate:strict": "(bun run check:strict) & (bun run test) & wait",
		"mcp:check": "bun tools/check-mcp-vertex.mjs",
		"mcp:test": "bun run --cwd plugins/portfolio-content test",
		"mcp:typecheck": "bun run --cwd plugins/portfolio-content typecheck",
		"mcp:all": "bun run mcp:typecheck && bun run mcp:test && bun run mcp:check",
		"serve:ssr:portfolio": "node dist/portfolio/server/server.mjs"
	},
	"private": true,
	"packageManager": "bun@1.3.14",
	"dependencies": {
		"@angular/common": "^22.0.0",
		"@angular/compiler": "^22.0.0",
		"@angular/core": "^22.0.0",
		"@angular/forms": "^22.0.0",
		"@angular/platform-browser": "^22.0.0",
		"@angular/platform-server": "^22.0.0",
		"@angular/router": "^22.0.0",
		"@angular/ssr": "^22.0.8",
		"@mcp-vertex/core": "file:../mcp-vertex/packages/core",
		"express": "^5.1.0",
		"rxjs": "~7.8.0",
		"simple-icons": "^16.27.0",
		"tslib": "^2.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@angular/build": "^22.0.8",
		"@angular/cli": "^22.0.8",
		"@angular/compiler-cli": "^22.0.0",
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.1",
		"@types/node": "^22.13.0",
		"angular-eslint": "^22.1.0",
		"eslint": "^10.8.0",
		"eslint-plugin-check-file": "^3.3.2",
		"globals": "^17.7.0",
		"jiti": "^2.7.0",
		"jsdom": "^28.0.0",
		"prettier": "^3.8.1",
		"typescript": "6.0.1-rc",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.0.8"
	}
}
