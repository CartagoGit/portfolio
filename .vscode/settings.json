{
	"terminal.integrated.profiles.linux": {
		"Bash (login)": {
			"path": "/bin/bash",
			"args": ["--login"]
		}
	},
	// Por defecto (para todo lo que abra terminal: Copilot incluido) → Bash
	"terminal.integrated.defaultProfile.linux": "Bash (login)",

	// ─────────────────────────────────────────────────────────────────────────
	// Peacock — color de marca del proyecto Portfolio
	//
	// Base: #1678ff (el `--blue` de la paleta "Midnight" en
	// src/styles/tokens/_themes.scss). Peacock oscurece 10 los elementos
	// superior y lateral para que encajen con el fondo azul marino.
	//
	// El bloque `workbench.colorCustomizations` ya está aplicado, así que el
	// color se ve aunque la extensión esté desactivada. Si ejecutás
	// "Peacock: Change Color", los valores de Peacock se recalculan sobre la
	// misma base y el resto de la paleta (editor, terminal, git…) se conserva
	// intacto gracias a `peacock.excludedSettings`.
	// ─────────────────────────────────────────────────────────────────────────
	"peacock.color": "#1678ff",
	"peacock.elementAdjustments": {
		"titleBar": "darken",
		"activityBar": "darken",
		"statusBar": "none"
	},
	"peacock.darkenLightenPercentage": 10,
	"peacock.keepForegroundColor": false,
	"peacock.keepBadgeColor": true,
	"peacock.showColorInStatusBar": true,
	"peacock.surpriseMeOnStartup": false,

	// Elementos que Peacock administra (se recalculan al cambiar de color).
	"peacock.affectActivityBar": true,
	"peacock.affectStatusBar": true,
	"peacock.affectTitleBar": true,
	"peacock.affectSideBarBorder": true,
	"peacock.affectSashHover": true,
	"peacock.affectTabActiveBorder": true,
	"peacock.affectStatusAndTitleBorders": true,
	"peacock.affectDebuggingStatusBar": true,
	"peacock.affectWindowBorder": true,

	// Estos los mantenemos a mano: el borde de grupos/panel y el fondo de la
	// pestaña activa quedarían demasiado saturados con el color plano.
	"peacock.affectEditorGroupBorder": false,
	"peacock.affectPanelBorder": false,
	"peacock.affectTabActiveBackground": false,

	// Claves que Peacock nunca debe pisar ni borrar.
	"peacock.excludedSettings": [
		"activityBarBadge.background",
		"activityBarBadge.foreground",
		"statusBarItem.remoteBackground",
		"statusBarItem.remoteForeground",
		"tab.activeBackground",
		"editorGroup.border",
		"panel.border",
		"editorError.foreground",
		"editorWarning.foreground",
		"editorInfo.foreground"
	],

	// La paleta está pensada para un tema oscuro (el proyecto es dark-first).
	"workbench.colorTheme": "Dark Modern",

