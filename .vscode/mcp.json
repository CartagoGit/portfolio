{
	"servers": {
		"delendai": {
			"type": "stdio",
			"command": "bun",
			"args": [
				"${workspaceFolder}/.cache/delendai-runtime/packages/cli/dist/index.js",
				"__serve",
				"--workspace=${workspaceFolder}",
				"--config=${workspaceFolder}/delendai.config.json",
				"--preset=swarm"
			]
		}
	}
}
