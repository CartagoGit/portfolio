{
	"name": "@portfolio/mcp-vertex-portfolio-content",
	"version": "0.2.0",
	"type": "module",
	"private": true,
	"description": "Local mcp-vertex plugin for the public portfolio. Audits public templates for forbidden terms / image TODOs and returns bilingual case-study briefs. Read-only.",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./public": {
			"types": "./src/public/index.ts",
			"import": "./src/public/index.ts"
		}
	},
	"files": [
		"src",
		"README.md",
		"tsconfig.json",
		"vitest.config.ts"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@mcp-vertex/core": "*"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
