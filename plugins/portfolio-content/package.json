{
	"name": "@portfolio/delendai-portfolio-content",
	"version": "0.4.0",
	"type": "module",
	"private": true,
	"description": "Project-local delendai plugin for the public portfolio. Read-only introspection derived from the working tree at call time, plus a public-content audit.",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./public": {
			"types": "./src/public/index.ts",
			"import": "./src/public/index.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
