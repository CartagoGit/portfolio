{
  "$schema": "../mcp-vertex/packages/core/schema/mcp-vertex.config.schema.json",
  "cacheDir": ".cache/mcp-vertex",
  "docsDir": "docs/mcp-vertex",
  "plugins": {
    "proposals": {
      "prefix": "work"
    },
    "memory": {
      "prefix": "memory"
    },
    "git": {
      "prefix": "git"
    },
    "search": {
      "prefix": "search",
      "options": {
        "roots": ["src", "docs", "README.md"],
        "maxResults": 24
      }
    },
    "quality": {
      "prefix": "quality"
    },
    "docs": {
      "prefix": "docs",
      "options": {
        "roots": ["README.md", "docs"],
        "maxResults": 50
      }
    },
    "portfolio-content": {
      "path": "tools/mcp-vertex/portfolio-content.mjs",
      "prefix": "portfolio",
      "options": {
        "contentPaths": [
          "src/app/portfolio-page.html",
          "src/features/portfolio/contact/contact-page.component.html",
          "src/features/portfolio/docker/docker-page.component.html",
          "src/features/portfolio/demos/demos-page.component.html"
        ],
        "forbiddenTerms": ["Beateam", "Mazinger", "MDM Platform", "Gestion de Tarifas"]
      }
    }
  }
}
